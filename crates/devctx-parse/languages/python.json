{
  "name": "python",
  "grammar": "python",
  "extensions": [
    "py",
    "pyi"
  ],
  "definitions": "(function_definition name: (identifier) @name) @definition.function\n(class_definition name: (identifier) @name) @definition.class\n(module (expression_statement (assignment left: (identifier) @name)) @definition.const)",
  "references": "(call function: (identifier) @name) @reference.call\n(call function: (attribute attribute: (identifier) @name)) @reference.call\n(type) @reference.type",
  "inherits": "(class_definition superclasses: (argument_list (identifier) @inherit.extends))\n(class_definition superclasses: (argument_list (attribute) @inherit.extends))",
  "types": "(assignment left: (identifier) @name type: (type (identifier) @type))\n(typed_parameter (identifier) @name type: (type (identifier) @type))",
  "imports": "(import_statement name: (dotted_name) @import.path) @import\n(import_statement name: (aliased_import name: (dotted_name) @import.path alias: (identifier) @import.alias)) @import\n(import_from_statement module_name: (_) @import.path name: (dotted_name) @import.name) @import\n(import_from_statement module_name: (_) @import.path name: (aliased_import name: (dotted_name) @import.name alias: (identifier) @import.alias)) @import\n(import_from_statement module_name: (_) @import.path (wildcard_import) @import.wildcard) @import",
  "type_names": [
    "identifier",
    "attribute"
  ],
  "function_kinds": [
    "function_definition"
  ],
  "container_kinds": [
    "class_definition"
  ],
  "platform_prefixes": [
    "os.",
    "sys.",
    "re.",
    "json.",
    "typing.",
    "collections.",
    "itertools.",
    "functools.",
    "pathlib.",
    "logging.",
    "datetime.",
    "subprocess.",
    "asyncio."
  ],
  "builtins": [
    "print",
    "len",
    "range",
    "str",
    "int",
    "float",
    "bool",
    "list",
    "dict",
    "set",
    "tuple",
    "open",
    "isinstance",
    "getattr",
    "setattr",
    "hasattr",
    "enumerate",
    "zip",
    "map",
    "filter",
    "sorted",
    "min",
    "max",
    "sum",
    "any",
    "all",
    "super",
    "type",
